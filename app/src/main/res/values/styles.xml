<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#070B1C</item>
        <item name="android:colorPrimary">#D9A94E</item>
        <item name="android:colorAccent">#D9A94E</item>
        <item name="android:statusBarColor">#070B1C</item>
        <item name="android:navigationBarColor">#070B1C</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <!-- أنيميشن صعود/هبوط لوحة الأرقام السفلية -->
    <style name="SheetAnim">
        <item name="android:windowEnterAnimation">@anim/slide_up_in</item>
        <item name="android:windowExitAnimation">@anim/slide_down_out</item>
    </style>
</resources>
